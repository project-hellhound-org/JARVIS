# J.A.R.V.I.S. — configuration
# Copy this file to config.yaml and fill in your values
# NEVER commit config.yaml — it contains secrets

model: qwen2.5:3b-instruct-q4_0
ollama_url: http://localhost:11434

# ── NVIDIA NIM (recommended — fast, free credits) ──────────────
# Get your free key at: https://build.nvidia.com
# Supports fast 11B–70B models at zero cost with generous free tier.
# Then set it as an environment variable (recommended):
#   export NVIDIA_API_KEY="nvapi-your_key_here"
#   echo 'export NVIDIA_API_KEY="nvapi-your_key_here"' >> ~/.bashrc
#
# Or paste it here (less secure — make sure config.yaml is gitignored):
nvidia_api_key: YOUR_NVIDIA_API_KEY_HERE
nvidia_model: nvidia/nemotron-3-super-120b-a12b
# ── Gemini API (free tier, fast) ───────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# Then set it as an environment variable (recommended):
#   export GEMINI_API_KEY="your_key_here"
#   echo 'export GEMINI_API_KEY="your_key_here"' >> ~/.bashrc
#
# Or paste it here (less secure — make sure config.yaml is gitignored):
gemini_api_key: YOUR_GEMINI_API_KEY_HERE

# ── Groq LPU Inference (ultra-low latency, free tier) ───────────
# Get your free key at: https://console.groq.com/keys
# Delivers sub-100ms LLaMA 3.3 70B & Whisper audio transcription.
#   export GROQ_API_KEY="gsk_your_key_here"
groq_api_key: YOUR_GROQ_API_KEY_HERE
groq_model: llama-3.3-70b-versatile

# ── God's Eye Geointel & Satellites (Optional Enhancements) ────
# Cesium Ion Access Token: https://ion.cesium.com/tokens
# Unlocks 3D Cesium World Terrain, photorealistic tiles & 3D OSM Buildings.
cesium_ion_token: YOUR_CESIUM_ION_TOKEN_HERE

# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unlocks live satellite active wildfire & thermal anomaly sensors (VIIRS / MODIS).
nasa_firms_key: YOUR_NASA_FIRMS_MAP_KEY_HERE

# ── Fish Audio Voice Synthesis ──────────────────────────────────
# Get your key at: https://fish.audio/app/developers
fish_audio_api_key: YOUR_FISH_AUDIO_API_KEY_HERE
fish_audio_model: s2.1-pro-free
fish_audio_voice_id: 05b36da8574341d0803391491850db20

assets_dir: assets
cases_dir: cases
persona: jarvis
jarvis_banner: jarvis-banner.png

tools:
  sherlock: true
  maigret: true
  whois: true
  dns: true
  crt_sh: true
  nmap: false

ui:
  mode: desktop
  theme: warm_cream
