# J.A.R.V.I.S. — configuration
# Copy this file to config.yaml and fill in your values
# NEVER commit config.yaml — it contains secrets

model: qwen2.5:3b-instruct-q4_0
ollama_url: http://localhost:11434

# ── Multimodal Vision & LLM Providers ──────────────────────────
# Optional: NVIDIA NIM API key for fast Nemotron & vision models (free credits at https://build.nvidia.com)
nvidia_api_key: YOUR_NVIDIA_API_KEY_HERE
nvidia_model: nvidia/nemotron-3-ultra-550b-a55b

# Optional: Google AI Studio Gemini API key for multimodal reasoning (free tier at https://aistudio.google.com/apikey)
gemini_api_key: YOUR_GEMINI_API_KEY_HERE

# Optional: Groq Cloud API key for ultra-fast LLaMA inference and Whisper STT (free tier at https://console.groq.com/keys)
groq_api_key: YOUR_GROQ_API_KEY_HERE
groq_model: openai/gpt-oss-120b

# ── God's Eye Geointel & Satellites ─────────────────────────────
# Optional: Cesium Ion token for 3D globe terrain and photorealistic photogrammetry (free tier at https://ion.cesium.com/tokens)
cesium_ion_token: YOUR_CESIUM_ION_TOKEN_HERE

# Optional: NASA FIRMS map key for thermal anomalies and satellite fire detection (free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
nasa_firms_key: YOUR_NASA_FIRMS_MAP_KEY_HERE

# ── OSINT & Open Data Feeds ────────────────────────────────────
# Optional: AISStream WebSocket key for live global maritime vessel tracking (free at https://aisstream.io)
aisstream_api_key: YOUR_AISSTREAM_API_KEY_HERE

# Optional: YouTube Data API v3 key for geotagged field video reconnaissance (free tier at https://console.cloud.google.com)
youtube_api_key: YOUR_YOUTUBE_API_KEY_HERE

# Optional: GitHub personal access token for higher OSINT repository search rate limits (free at https://github.com/settings/tokens)
github_token: YOUR_GITHUB_TOKEN_HERE

# ── Voice Synthesis ───────────────────────────────────────────
# Optional: Fish Audio API key for low-latency neural TTS streaming (free tier at https://fish.audio/app/developers)
fish_audio_api_key: YOUR_FISH_AUDIO_API_KEY_HERE
fish_audio_model: s2.1-pro-free

# Optional: Fish Audio custom voice model ID (browse free community voices at https://fish.audio/discovery)
fish_audio_voice_id: 05b36da8574341d0803391491850db20

# ── Smart Home Integration ─────────────────────────────────────
# Optional: Home Assistant base URL for local smart home control (free open-source at https://www.home-assistant.io)
hass_url: YOUR_HASS_URL_HERE

# Optional: Home Assistant Long-Lived Access Token (free in your Home Assistant user profile page)
hass_token: YOUR_HASS_TOKEN_HERE

assets_dir: assets
cases_dir: cases
persona: jarvis
jarvis_banner: jarvis-banner.png

tools:
  sherlock: true
  maigret: true
  whois: true
  dns: true
  crt_sh: true
  nmap: false

ui:
  mode: desktop
  theme: warm_cream

# ── Voice Activation & Continued-Conversation Pipeline ───────────
audio_pipeline:
  wake_word_sensitivity: 0.78
  speech_hangover_ms: 800
  silence_timeout_sec: 0.8
  vad_mode: dynamic_low_latency
  # Multi-phrase activation list (all trigger local matching)
  wake_phrases:
    - "jarvis"
    - "hey jarvis"
    - "jarvis you there"
    - "wake up jarvis"
    - "alright jarvis"
    - "yo jarvis"
  # Continued-conversation open-mic duration (seconds) after JARVIS replies
  follow_up_window_sec: 10.0
