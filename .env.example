# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and set your API keys.
# DO NOT commit your real .env file.

# ── Multimodal Vision & LLM Providers ────────────────────────────────
# Google AI Studio Gemini API Key (Vision & Reasoning): https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API Key (Nemotron & Vision): https://build.nvidia.com
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Groq LPU Cloud Key (Fast Whisper STT & LLaMA 3.3): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# ── Maritime Intel & AIS Telemetry ────────────────────────────────────
# AISStream WebSocket API Key (Live global commercial vessel tracking): https://aisstream.io
# AISSTREAM_API_KEY=your_aisstream_api_key_here

# ── Cesium 3D Globe & Earth Observation ──────────────────────────────
# Cesium Ion Token: https://ion.cesium.com/tokens
# CESIUM_ION_TOKEN=your_cesium_ion_token_here

# NASA FIRMS Key (Active fire and thermal anomalies): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# ── Voice Synthesis ───────────────────────────────────────────────────
# Fish Audio API Key (Low-latency neural TTS): https://fish.audio/app/developers
# FISH_AUDIO_API_KEY=your_fish_audio_key_here
