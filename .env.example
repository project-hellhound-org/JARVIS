# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and set your API keys.
# DO NOT commit your real .env file.

# ── Multimodal Vision & LLM Providers ────────────────────────────────
# Optional: Google AI Studio Gemini API key for multimodal reasoning (free tier at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: NVIDIA NIM API key for Nemotron LLM & vision models (free credits at https://build.nvidia.com)
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Groq Cloud API key for ultra-fast LLaMA inference and Whisper STT (free tier at https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# ── God's Eye Geointel & Earth Observation ────────────────────────────
# Optional: Cesium Ion token for 3D globe terrain and photorealistic tiles (free tier at https://ion.cesium.com/tokens)
# CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Optional: NASA FIRMS map key for thermal anomalies and wildfire sensors (free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# ── OSINT & Maritime Telemetry ────────────────────────────────────────
# Optional: AISStream WebSocket key for live maritime vessel tracking (free at https://aisstream.io)
# AISSTREAM_API_KEY=your_aisstream_api_key_here

# Optional: YouTube Data API v3 key for geotagged field video reconnaissance (free tier at https://console.cloud.google.com)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: GitHub personal access token for higher OSINT search rate limits (free at https://github.com/settings/tokens)
# GITHUB_TOKEN=your_github_token_here

# ── Voice Synthesis ───────────────────────────────────────────────────
# Optional: Fish Audio API key for low-latency neural TTS (free tier at https://fish.audio/app/developers)
# FISH_AUDIO_API_KEY=your_fish_audio_key_here

# Optional: Fish Audio voice model ID (browse free community voices at https://fish.audio/discovery)
# FISH_AUDIO_VOICE_ID=05b36da8574341d0803391491850db20

# ── Smart Home Integration ───────────────────────────────────────────
# Optional: Home Assistant base URL for local smart home control (free open-source at https://www.home-assistant.io)
# HASS_URL=http://homeassistant.local:8123

# Optional: Home Assistant Long-Lived Access Token (free in your Home Assistant profile page)
# HASS_TOKEN=your_hass_token_here
